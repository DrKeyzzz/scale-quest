rules_version = '2';

// Shared rules for all class games in this Firebase project.
// Each game keeps its scores under /games/<game-id>/scores.
// Anyone can read a leaderboard. Games can only ADD scores that pass that
// game's check below. Editing and deleting is done by the teacher in the
// Firebase console. Anything not listed here is blocked.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Scale Quest ----------
    match /games/scale-quest/scores/{scoreId} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if scaleQuestScore(request.resource.data);
    }

    // ---------- Add new games below ----------
    // match /games/<game-id>/scores/{scoreId} {
    //   allow read: if true;
    //   allow create: if <that game's check>;
    // }
  }

  // A finished 20-question CHAOS run.
  function scaleQuestScore(d) {
    return d.keys().hasOnly(['name', 'score', 'points', 'streak', 'accuracy', 'questions', 'keyCount', 'keys', 'created'])
      && d.keys().hasAll(['name', 'score', 'points', 'streak', 'accuracy', 'questions', 'keyCount', 'keys', 'created'])
      && d.name is string && d.name.matches('^[A-Z0-9?]{1,3}$')
      && d.questions == 20
      && d.keyCount is int && d.keyCount >= 1 && d.keyCount <= 15
      && d.points is int && d.points >= 0 && d.points <= 4650      // 20 perfect answers + max speed + streak bonuses
      && d.score is int
      && d.score >= d.points * (9 + d.keyCount) / 10 - 1               // score = points × key bonus
      && d.score <= d.points * (9 + d.keyCount) / 10 + 1
      && d.streak is int && d.streak >= 0 && d.streak <= 20
      && d.accuracy is int && d.accuracy >= 0 && d.accuracy <= 100
      && d.keys is string && d.keys.size() <= 60
      && d.created == request.time;
  }
}
